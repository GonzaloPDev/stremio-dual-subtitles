# Dual Subtitles Addon Configuration
# Copy this file to .env and configure your settings

# ============================================================================
# SERVER CONFIGURATION
# ============================================================================

# Port for the addon server (default: 7000)
PORT=7000

# Host to bind to (default: 0.0.0.0 for all interfaces)
HOST=0.0.0.0

# External URL for accessing the addon remotely
# Required if running behind a reverse proxy or accessing from another device
# Examples:
# - Local network: http://192.168.1.100:7000
# - Public domain: https://dualsubtitles.example.com
# - Ngrok tunnel: https://abc123.ngrok.io
# EXTERNAL_URL=http://localhost:7000

# Custom addon name (useful for distinguishing instances)
# ADDON_NAME=My Dual Subtitles

# Rate limiting (per IP)
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_MAX=60

# ============================================================================
# SUBTITLE STYLING
# ============================================================================

# The merged subtitle is served as ASS so each language can carry its own
# color and font size. Requires "Settings -> Player -> ASS subtitles styling"
# to be ON in Stremio (it defaults to OFF). With it off you still get both
# languages on two readable lines, just without the color/size difference.
#
# Set to 'srt' to serve plain SRT instead (no per-language styling at all:
# Stremio strips HTML tags out of SRT cues before rendering them).
# DUAL_SUB_FORMAT=ass

# Sizes are relative to a 1920x1080 reference that libass scales to the real
# screen, so one value looks the same on a phone and on a 4K TV.

# Font family used for both lines
# DUAL_SUB_FONT=Arial

# Primary language (top line) - defaults to white at full size
# DUAL_SUB_MAIN_SIZE=54
# DUAL_SUB_MAIN_COLOR=#FFFFFF

# Secondary language (line below) - defaults to a smaller, soft yellow line
# DUAL_SUB_TRANS_SIZE=40
# DUAL_SUB_TRANS_COLOR_ASS=#FFE9A3

# Outline and placement
# DUAL_SUB_OUTLINE_COLOR=#101010
# DUAL_SUB_OUTLINE=2.6
# DUAL_SUB_MARGIN_V=60
# DUAL_SUB_MARGIN_H=40

# ============================================================================
# OPTIONAL: DEBUG MODE
# ============================================================================

# Enable debug logging (set to 'true' for verbose output)
# NEXT_PUBLIC_DEBUG_MODE=true
# DEBUG_MODE=true

# ============================================================================
# ANALYTICS PROTECTION
# ============================================================================

# Secret key to protect /stats page (only you can access analytics)
# Access via: https://your-domain.com/stats?key=YOUR_SECRET_KEY
# If not set, analytics page is public (not recommended)
ANALYTICS_SECRET=your-secret-key-here

# ============================================================================
# PERSISTENT ANALYTICS (Upstash Redis)
# ============================================================================

# Upstash Redis REST API for persistent analytics counters.
# Without these, analytics work in-memory only (reset on restart).
# Sign up free at https://upstash.com (no credit card required).
# UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your-token-here

